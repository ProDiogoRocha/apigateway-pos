{
  "info": {
    "name": "BFF Posição - Desenvolvimento",
    "description": "Oito operações do API Gateway em dev, obtenção de STS e preflight CORS. Configure o environment antes de enviar requests. Reversão altera a posição selecionada.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "STS",
      "item": [
        {
          "name": "00 - Obter token STS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{stsUrl}}",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const token = pm.response.json().access_token;",
                  "  if (token) pm.environment.set(\"tokenSts\", token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
