    {
      "name": "CORS",
      "item": [
        {
          "name": "09 - Preflight sem token",
          "request": {
            "method": "OPTIONS",
            "url": "{{baseUrl}}{{corsPath}}",
            "header": [
              {
                "key": "Origin",
                "value": "{{corsOrigin}}"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "{{corsMethod}}"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "authorization,x-itau-apikey,x-itau-correlationID,content-type"
              }
            ]
