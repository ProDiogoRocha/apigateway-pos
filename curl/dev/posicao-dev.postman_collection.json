              },
              {
                "key": "x-itau-apikey",
                "value": "{{apiKey}}"
              },
              {
                "key": "x-itau-correlationID",
                "value": "{{$guid}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/centralizadores/{{centralizador}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "centralizadores",
                "{{centralizador}}"
              ],
              "query": []
            },
            "description": "Consultar centralizador. Permissão STS: numerario-posicao-transportadores.read."
          }
