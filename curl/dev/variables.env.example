# Copie para variables.local.env, preencha e carregue: source ./variables.local.env
# URL REAL do BFF em dev, incluindo o mapping configurado, sem barra final.
# Pode ser o domínio corporativo ou https://<api-id>.execute-api.sa-east-1.amazonaws.com/dev
export BASE_URL=''
export STS_URL='https://des-sts-int.mbi.cloud.ihf/api/oauth/token'
export STS_CLIENT_ID=''
export STS_CLIENT_SECRET=''
# Somente o access_token, sem o prefixo Bearer.
export TOKEN_STS=''
export API_KEY='1'
# Exemplos usados no TAAC; ajuste conforme a massa disponível em dev.
export CENTRALIZADOR='7619'
export POLO='001'
export TRANSPORTADORA='56'
export DATA_MOVIMENTO="$(TZ=America/Sao_Paulo date +%F)"
# codigoBaseFornecedor devolvido pela consulta de fornecedor.
export BASE_ID=''
# cards[].indiceControlePosicao devolvido pela consulta de cards.
export INDICE_CONTROLE_POSICAO=''
# Exemplo do contrato; confirme o tipo da posição escolhida.
export CODIGO_TIPO_POSICAO='F'
# Origem do front configurada no CORS; usada apenas no preflight.
export CORS_ORIGIN=''
# Opcional: mesmo ID para correlacionar as chamadas de uma investigação.
# Sem isso cada execução cria seu próprio identificador.
# export CORRELATION_ID='curl-dev-investigacao-001'
